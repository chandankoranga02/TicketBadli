generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────────────────────

model User {
  id                      String    @id @default(uuid())
  userId                  String    @unique @map("user_id")
  email                   String    @unique
  role                    UserRole  @default(USER)
  phone                   String?
  accountCompletionStatus Boolean   @default(false) @map("account_completion_status")
  photo                   String?
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

enum UserRole {
  USER
  ADMIN
}

model UserDevice {
  id          String   @id @default(uuid())
  userId      String

  deviceName  String?
  ipAddress   String?
  os          String?
  browser     String?

  latitude    Float?
  longitude   Float?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User    @relation(fields: [userId], references: [id])
}